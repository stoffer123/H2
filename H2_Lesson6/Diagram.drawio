        <mxCell id="note1" value="Regel: en bil kan kun indgaa i EEN aktiv udlejning ad gangen (EndDate == null). Over tid kan samme bil godt have mange afsluttede udlejninger - derfor 0..* og ikke 0..1." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=18;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="580" width="300" height="110" as="geometry" />
        </mxCell>
        <mxCell id="note2" value="Kanalen for kvittering er ikke besluttet endnu. Rental kender kun interfacet og faar afsenderen ind via konstruktoeren, saa en ny kanal = en ny klasse - ingen aendringer i Rental." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=18;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;" vertex="1" parent="1">
